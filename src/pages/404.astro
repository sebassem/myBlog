---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Page Not Found" noindex>
  <section class="max-w-2xl mx-auto px-4 py-20 text-center">
    <div class="neo-box p-8 sm:p-12">
      <span class="neo-pill px-4 py-1 text-sm bg-[var(--pink)] text-black">Error 404</span>
      <h1 class="text-6xl sm:text-7xl font-black mt-4 tracking-tight">
        <span class="neo-highlight"><span>Lost in the Cloud</span></span>
      </h1>
      <p class="mt-4 text-lg text-[var(--ink-muted)]">
        The page you&apos;re looking for doesn&apos;t exist or has moved.
      </p>
      <div class="flex flex-wrap justify-center gap-4 mt-8">
        <a href="/" class="neo-btn px-6 py-3 bg-[var(--yellow)] text-black rounded-full">
          <i class="ri-home-4-line"></i> Back to Home
        </a>
        <a href="/search/" class="neo-btn px-6 py-3 bg-[var(--blue)] text-black rounded-full">
          <i class="ri-search-line"></i> Search Articles
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
