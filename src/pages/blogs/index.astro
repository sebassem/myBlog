---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryFilter from '../../components/CategoryFilter.astro';
import PostCard from '../../components/PostCard.astro';
import NewsletterBox from '../../components/NewsletterBox.astro';
import { getPublishedPosts } from '../../utils/posts';

const allPosts = await getPublishedPosts();
---

<BaseLayout title="All Articles">
  <section class="max-w-5xl mx-auto px-4 pt-12 pb-6">
    <div class="mb-8">
      <h1 class="text-4xl md:text-5xl font-black tracking-tight">
        All <span class="neo-highlight"><span>Articles</span></span>
      </h1>
      <p class="mt-2 text-base text-[var(--ink-muted)]">
        {allPosts.length} published articles across Azure, Kubernetes, AI, and book reviews.
      </p>
    </div>

    <CategoryFilter activeSlug="all" />
  </section>

  <section class="max-w-5xl mx-auto px-4 py-6">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {allPosts.map((post) => (
        <PostCard post={post} />
      ))}
    </div>
  </section>

  <NewsletterBox />
</BaseLayout>
