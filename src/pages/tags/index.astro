---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, getTagSlug } from '../../utils/posts';

const allPosts = await getPublishedPosts();
const tagMap = new Map<string, { label: string; count: number }>();

for (const post of allPosts) {
  for (const tag of post.data.tags ?? []) {
    const slug = getTagSlug(tag);
    if (!slug) continue;
    const existing = tagMap.get(slug);
    if (existing) {
      existing.count += 1;
    } else {
      tagMap.set(slug, { label: tag, count: 1 });
    }
  }
}

const tags = Array.from(tagMap.entries()).sort((a, b) => b[1].count - a[1].count);
---

<BaseLayout title="Tags">
  <section class="max-w-5xl mx-auto px-4 pt-12 pb-6">
    <h1 class="text-4xl md:text-5xl font-black tracking-tight mb-3">
      All <span class="neo-highlight"><span>Tags</span></span>
    </h1>
    <p class="text-[var(--ink-muted)] mb-8">
      {tags.length} topics covered across the blog.
    </p>

    <div class="neo-box p-6 sm:p-8 flex flex-wrap gap-3">
      {tags.map(([slug, { label, count }]) => (
        <a
          href={`/tags/${slug}/`}
          class="neo-pill px-3.5 py-1.5 text-sm bg-[var(--surface-subtle)] text-[var(--ink)] hover:bg-[var(--yellow)] hover:text-black"
        >
          <span>#{label}</span>
          <span class="px-1.5 py-0.5 text-xs bg-[var(--blue)] text-black rounded-full border border-black">
            {count}
          </span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
