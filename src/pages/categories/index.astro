---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsletterBox from '../../components/NewsletterBox.astro';
import {
  getCategoryColor,
  getCategoryDisplayName,
  getCategorySlug,
  getPublishedPosts,
} from '../../utils/posts';

const allPosts = await getPublishedPosts();
const counts = new Map<string, number>();

for (const post of allPosts) {
  for (const cat of post.data.categories ?? []) {
    const slug = getCategorySlug(cat);
    counts.set(slug, (counts.get(slug) ?? 0) + 1);
  }
}

const categories = Array.from(counts.entries()).sort((a, b) => b[1] - a[1]);
---

<BaseLayout title="Categories">
  <section class="max-w-5xl mx-auto px-4 pt-12 pb-6">
    <h1 class="text-4xl md:text-5xl font-black tracking-tight mb-3">
      Browse by <span class="neo-highlight"><span>Category</span></span>
    </h1>
    <p class="text-[var(--ink-muted)] mb-10">
      Explore articles grouped by topic and format.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      {categories.map(([slug, count]) => {
        const color = getCategoryColor(slug);
        const bg =
          color === 'pink'
            ? 'bg-[var(--pink)]'
            : color === 'yellow'
              ? 'bg-[var(--yellow)]'
              : 'bg-[var(--blue)]';
        return (
          <a
            href={`/categories/${slug}/`}
            class="neo-card neo-card-hover p-6 flex items-center justify-between gap-4"
          >
            <div>
              <span class={`neo-pill px-3 py-0.5 text-xs text-black ${bg}`}>Category</span>
              <h2 class="text-2xl font-black mt-3">{getCategoryDisplayName(slug)}</h2>
            </div>
            <div class="text-3xl font-black px-4 py-2 border-2 border-[var(--border-color)] bg-[var(--surface-subtle)]">
              {count}
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <NewsletterBox />
</BaseLayout>
