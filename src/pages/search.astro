---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Search" description="Search all articles on Seif Bassem's Cloud Blog" noindex>
  <section class="max-w-4xl mx-auto px-4 pt-12">
    <div class="mb-8">
      <h1 class="text-4xl md:text-5xl font-black tracking-tight">
        Search <span class="neo-highlight"><span>Articles</span></span>
      </h1>
      <p class="mt-2 text-[var(--ink-muted)]">
        Instant full-text search across all Azure, Kubernetes, AI, and book review articles.
      </p>
    </div>

    <div class="neo-box p-6 sm:p-8">
      <div id="search"></div>
    </div>
  </section>

  <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
    window.addEventListener('DOMContentLoaded', () => {
      if (typeof PagefindUI !== 'undefined') {
        new PagefindUI({
          element: '#search',
          showSubResults: true,
          showImages: false,
        });
      } else {
        const el = document.getElementById('search');
        if (el) {
          el.innerHTML =
            '<p class="text-sm font-medium opacity-75">Search index is generated during <code>npm run build</code>. Run a production build and preview to test Pagefind search.</p>';
        }
      }
    });
  </script>
</BaseLayout>
