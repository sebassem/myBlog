---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{items.length >= 4 && (
  <details
    open
    class="mb-8 border-2 border-[var(--border-color)] bg-[var(--surface-subtle)] p-4 sm:p-5 shadow-[4px_4px_0px_var(--shadow-color)]"
    data-pagefind-ignore
  >
    <summary class="flex items-center justify-between cursor-pointer list-none font-black text-base select-none">
      <span class="inline-flex items-center gap-2">
        <i class="ri-list-unordered text-lg"></i>
        <span>Table of Contents</span>
        <span class="text-xs font-semibold px-2 py-0.5 border border-[var(--border-color)] bg-[var(--surface)] rounded-full">
          {items.length}
        </span>
      </span>
      <i class="ri-arrow-down-s-line text-xl transition-transform duration-200 toc-chevron"></i>
    </summary>

    <nav aria-label="Table of contents" class="mt-4 pt-3 border-t-2 border-[var(--border-color)]/30">
      <ul class="space-y-1.5 text-sm">
        {items.map((h) => (
          <li class={h.depth === 3 ? 'pl-4' : ''}>
            <a
              href={`#${h.slug}`}
              class="inline-flex items-baseline gap-1.5 text-[var(--ink-muted)] hover:text-[var(--ink)] hover:underline decoration-2 decoration-[var(--yellow)] underline-offset-4 transition-colors"
              class:list={[h.depth === 2 ? 'font-semibold text-[var(--ink)]' : 'font-normal']}
            >
              <span class="opacity-50 text-xs">{h.depth === 2 ? '→' : '·'}</span>
              <span>{h.text}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </details>
)}

<style>
  details[open] .toc-chevron {
    transform: rotate(180deg);
  }
</style>
