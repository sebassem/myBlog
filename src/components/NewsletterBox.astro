---
import { SITE } from '../config/site';
---

<section class="max-w-5xl mx-auto px-4 mt-16">
  <div class="relative border-3 border-[var(--border-color)] bg-[var(--blue)] text-black p-6 md:p-8 shadow-[6px_6px_0px_var(--shadow-color)]">
    <!-- Corner handles matching seifbassem.com -->
    <div class="size-2.5 bg-white border-2 border-black absolute -top-2 -left-2"></div>
    <div class="size-2.5 bg-white border-2 border-black absolute -top-2 -right-2"></div>
    <div class="size-2.5 bg-white border-2 border-black absolute -bottom-2 -left-2"></div>
    <div class="size-2.5 bg-white border-2 border-black absolute -bottom-2 -right-2"></div>

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div class="max-w-md">
        <h3 class="text-2xl font-black tracking-tight">Stay in the loop</h3>
        <p class="text-sm md:text-base mt-1 font-medium opacity-90">
          Get new Azure, Kubernetes, and AI architecture posts delivered straight to your inbox.
        </p>
      </div>

      <form
        action={SITE.forms.mailchimpAction}
        method="post"
        name="mc-embedded-subscribe-form"
        target="_blank"
        class="flex flex-col sm:flex-row gap-3 w-full md:w-auto flex-1 max-w-md"
      >
        <input
          type="email"
          name="EMAIL"
          required
          placeholder="you@example.com"
          aria-label="Email address"
          class="flex-1 bg-white text-black px-4 py-2.5 border-2 border-black font-medium focus:outline-none focus:ring-2 focus:ring-black"
        />
        <div style="position: absolute; left: -5000px;" aria-hidden="true">
          <input type="text" name={SITE.forms.mailchimpBotField} tabindex="-1" value="" />
        </div>
        <button
          type="submit"
          class="px-5 py-2.5 bg-[var(--yellow)] text-black font-bold border-2 border-black shadow-[3px_3px_0px_#000] hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[5px_5px_0px_#000] transition-all cursor-pointer whitespace-nowrap"
        >
          Subscribe <i class="ri-send-plane-line ml-1"></i>
        </button>
      </form>
    </div>
  </div>
</section>
