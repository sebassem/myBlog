---
import type { BlogPost } from '../utils/posts';
import PostCard from './PostCard.astro';

interface Props {
  posts: BlogPost[];
}

const { posts } = Astro.props;
---

{posts.length > 0 && (
  <section class="max-w-6xl mx-auto px-4 mt-16">
    <h2 class="text-2xl md:text-3xl font-black mb-6">
      <span class="neo-highlight"><span>Related Articles</span></span>
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {posts.map((post) => (
        <PostCard post={post} compact />
      ))}
    </div>
  </section>
)}
